# =============================================================================
# AZD Transport — Umgebungsvariablen
# =============================================================================
# Kopiere diese Datei nach `.env.local` und trage deine Werte ein:
#
#     cp .env.example .env.local
#
# `.env.local` steht in .gitignore und darf NIEMALS ins Repository.
#
# Variablen mit dem Präfix NEXT_PUBLIC_ landen im Browser-Bündel und sind für
# jeden sichtbar. Alle anderen bleiben serverseitig.
#
# Die Anwendung hat keine Datenbank und keine Anmeldung. Sie besteht aus
# öffentlichen Seiten und einem Anfrageformular, das per E-Mail zugestellt
# wird — mehr braucht sie nicht.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. ADRESSE — Pflicht in der Produktion
# -----------------------------------------------------------------------------
# Die öffentliche Adresse der Website, OHNE Schrägstrich am Ende.
#
# Daraus werden die Canonical-Angaben, die OpenGraph-Vorschau, die Sitemap und
# die strukturierten Daten gebaut. Außerdem leitet der Proxy auf genau diesen
# Hostnamen um, damit die Seite nicht unter zwei Adressen erreichbar ist.
#
# Lokal:      http://localhost:3000
# Produktion: https://www.azd-transport.com
NEXT_PUBLIC_APP_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# 2. E-MAIL — ohne diese Werte kommt keine Anfrage an
# -----------------------------------------------------------------------------
# Ohne EMAIL_API_KEY wird nichts versendet. Das Formular meldet dann ehrlich
# einen Fehler und verweist auf Telefon und WhatsApp, statt einen Erfolg
# vorzutäuschen, bei dem niemand die Anfrage je liest. /api/health zeigt den
# Zustand an.

# resend | postmark  (Standard: resend, sobald ein Schlüssel gesetzt ist)
EMAIL_PROVIDER=resend

# Der Schlüssel des Anbieters, bei Resend z. B. re_xxxxxxxx
EMAIL_API_KEY=

# Absenderadresse. Format: "AZD Transport <info@azd-transport.com>"
#
# ⚠ Die Domain muss dir gehören und beim Anbieter per DNS-Eintrag verifiziert
#   sein. Eine Freemail-Adresse (@outlook.com, @gmail.com, @web.de, @gmx.de …)
#   funktioniert NICHT: diese Domains gehören Microsoft, Google und Co., du
#   kannst sie nicht verifizieren, und jeder Versand scheitert.
EMAIL_FROM=

# Wohin Antworten gehen sollen, wenn die Anfrage keine E-Mail-Adresse enthält.
# Hier darf eine Freemail-Adresse stehen: versendet wird über die verifizierte
# Domain, "Antworten" landet in deinem gewohnten Postfach.
EMAIL_REPLY_TO=

# Wohin die Anfragen zugestellt werden. Leer = info@azd-transport.com
# (der Wert aus src/config/site.ts).
REQUEST_INBOX=
