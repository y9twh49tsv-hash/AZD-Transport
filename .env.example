# =============================================================================
# AZD Transport — Environment Variables
# =============================================================================
# Kopiere diese Datei nach `.env.local` und trage deine eigenen Werte ein:
#
#     cp .env.example .env.local
#
# `.env.local` ist in .gitignore und darf NIEMALS ins Repository.
#
# Variablen mit dem Präfix NEXT_PUBLIC_ landen im Browser-Bundle und sind für
# jeden sichtbar. Alle anderen bleiben serverseitig.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. SUPABASE — PFLICHT
# -----------------------------------------------------------------------------
# Supabase Dashboard → dein Projekt → Project Settings → API

# Die Projekt-URL, z. B. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Der "anon"/"publishable" Key. Er darf öffentlich sein — was damit erreichbar
# ist, entscheiden die Row-Level-Security-Policies in der Datenbank.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Der "service_role"/"secret" Key. ⚠ ER UMGEHT ALLE SICHERHEITSREGELN.
# Niemals mit NEXT_PUBLIC_ Präfix, niemals im Frontend, niemals committen.
# Wird nur serverseitig verwendet (Buchungen anlegen, QR-Token auflösen, Uploads).
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# 2. APP — PFLICHT für E-Mails, QR-Codes und Angebotslinks
# -----------------------------------------------------------------------------
# Die öffentliche Adresse deiner Anwendung, OHNE Schrägstrich am Ende.
# Lokal: http://localhost:3000
# Produktion: https://deine-domain.de
NEXT_PUBLIC_APP_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# 3. E-MAIL — optional, aber vor dem Livegang dringend empfohlen
# -----------------------------------------------------------------------------
# Ohne EMAIL_API_KEY werden E-Mails NICHT versendet, sondern nur im Serverlog
# vermerkt. Buchungen funktionieren trotzdem.

# resend | postmark  (Standard: resend, sobald ein Key gesetzt ist)
EMAIL_PROVIDER=resend

# API-Key des Anbieters, z. B. re_xxxxxxxx bei Resend
EMAIL_API_KEY=

# Absenderadresse. Format: "AZD Transport <info@deine-domain.de>"
#
# ⚠ Die Domain muss dir gehören und beim Anbieter per DNS-Eintrag verifiziert
#   sein. Eine Freemail-Adresse (@outlook.com, @gmail.com, @web.de, @gmx.de …)
#   funktioniert NICHT: diese Domains gehören Microsoft, Google und Co., du
#   kannst sie nicht verifizieren, und jeder Versand scheitert mit 403 — ohne
#   dass die Buchung selbst einen Fehler zeigt. /api/health weist darauf hin.
#
# Zum Ausprobieren ohne eigene Domain kannst du EMAIL_FROM leer lassen. Dann
# wird über onboarding@resend.dev versendet — das erreicht aber ausschließlich
# die Adresse, mit der du dich bei Resend registriert hast.
EMAIL_FROM=

# Wohin Antworten der Kundschaft gehen sollen. Hier darf eine Freemail-Adresse
# stehen: versendet wird über die verifizierte Domain, "Antworten" landet in
# deinem gewohnten Postfach.
EMAIL_REPLY_TO=

# Wohin die Meldung über eine neue Buchung geht: Sendungsnummer, ob abgeholt
# werden muss oder der Kunde vorbeikommt, Abholadresse und Telefonnummern.
# Leer = die Kontaktadresse der Marke. Diese Mail geht an den Betrieb, nicht an
# die Kundschaft — hier dürfen Adressen stehen.
OPERATOR_EMAIL=

# Dieselbe Meldung zusätzlich per WhatsApp. Wirkt nur mit den API-Werten unter
# Punkt 4 — ein WhatsApp-Business-Konto allein genügt nicht. Leer = die Nummer
# aus NEXT_PUBLIC_WHATSAPP_NUMBER.
OPERATOR_WHATSAPP=


# -----------------------------------------------------------------------------
# 4. WHATSAPP — optional, erst wenn du die Meta Cloud API nutzen willst
# -----------------------------------------------------------------------------
# Ohne diese Werte nutzt die App nur kostenlose wa.me-Deep-Links (funktioniert
# sofort, ohne Vertrag). Mit diesen Werten versendet sie zusätzlich automatische
# Nachrichten über die Meta WhatsApp Cloud API.
#
# Wichtig: Die WhatsApp Business *App* auf dem Handy reicht dafür nicht. Nötig
# ist die WhatsApp Business *Platform* (Cloud API) im Meta Business Manager,
# mit einer Telefonnummer, die NICHT in der App registriert ist, plus einer
# genehmigten Nachrichtenvorlage.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Name der bei Meta freigegebenen Nachrichtenvorlage
WHATSAPP_TEMPLATE_NAME=shipment_update
WHATSAPP_TEMPLATE_LOCALE=de


# -----------------------------------------------------------------------------
# 5. MARKE — optional (Standardwerte stehen in src/config/brand.ts)
# -----------------------------------------------------------------------------
# Nur setzen, wenn du die Marke ohne Codeänderung anpassen möchtest.
NEXT_PUBLIC_BRAND_NAME=AZD Transport
NEXT_PUBLIC_BRAND_LEGAL_NAME=
NEXT_PUBLIC_TRACKING_PREFIX=MC
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Nur Ziffern, international, z. B. 4917612345678
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_STREET=
NEXT_PUBLIC_CONTACT_ZIP=
NEXT_PUBLIC_CONTACT_CITY=
