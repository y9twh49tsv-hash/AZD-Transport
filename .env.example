# =============================================================================
# AZD Transport — Umgebungsvariablen
# =============================================================================
# Kopiere diese Datei nach `.env.local` und trage deine Werte ein:
#
#     cp .env.example .env.local
#
# `.env.local` steht in .gitignore und darf NIEMALS ins Repository.
#
# Variablen mit dem Präfix NEXT_PUBLIC_ landen im Browser-Bündel und sind für
# jeden sichtbar. Alle anderen bleiben serverseitig.
#
# Die Anwendung hat keine Datenbank und keine Anmeldung. Sie besteht aus
# öffentlichen Seiten und einem Anfrageformular, das per E-Mail zugestellt
# wird — mehr braucht sie nicht.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. ADRESSE — Pflicht in der Produktion
# -----------------------------------------------------------------------------
# Die öffentliche Adresse der Website, OHNE Schrägstrich am Ende.
#
# Daraus werden die Canonical-Angaben, die OpenGraph-Vorschau, die Sitemap und
# die strukturierten Daten gebaut. Außerdem leitet der Proxy auf genau diesen
# Hostnamen um, damit die Seite nicht unter zwei Adressen erreichbar ist.
#
# Lokal:      http://localhost:3000
# Produktion: https://www.azd-transport.com
NEXT_PUBLIC_APP_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# 2. E-MAIL — ohne diese Werte kommt keine Anfrage an
# -----------------------------------------------------------------------------
# Ohne EMAIL_API_KEY wird nichts versendet. Das Formular meldet dann ehrlich
# einen Fehler und verweist auf Telefon und WhatsApp, statt einen Erfolg
# vorzutäuschen, bei dem niemand die Anfrage je liest. /api/health zeigt den
# Zustand an.

# resend | postmark  (Standard: resend, sobald ein Schlüssel gesetzt ist)
EMAIL_PROVIDER=resend

# Der Schlüssel des Anbieters, bei Resend z. B. re_xxxxxxxx
EMAIL_API_KEY=

# Absenderadresse. Format: "AZD Transport <info@azd-transport.com>"
#
# ⚠ Die Domain muss dir gehören und beim Anbieter per DNS-Eintrag verifiziert
#   sein. Eine Freemail-Adresse (@outlook.com, @gmail.com, @web.de, @gmx.de …)
#   funktioniert NICHT: diese Domains gehören Microsoft, Google und Co., du
#   kannst sie nicht verifizieren, und jeder Versand scheitert.
EMAIL_FROM=

# Wohin Antworten gehen sollen, wenn die Anfrage keine E-Mail-Adresse enthält.
# Hier darf eine Freemail-Adresse stehen: versendet wird über die verifizierte
# Domain, "Antworten" landet in deinem gewohnten Postfach.
EMAIL_REPLY_TO=

# Wohin die Anfragen zugestellt werden. Leer = info@azd-transport.com
# (der Wert aus src/config/site.ts).
REQUEST_INBOX=


# -----------------------------------------------------------------------------
# 3. WHATSAPP — optional, für die automatische Meldung aufs Handy
# -----------------------------------------------------------------------------
# Ohne diese Werte nutzt die Seite nur kostenlose wa.me-Links: der Kunde füllt
# das Formular aus, tippt auf „Anfrage per WhatsApp senden" und drückt in
# WhatsApp einmal auf Senden. Das funktioniert sofort und ohne Vertrag.
#
# Mit diesen Werten schickt zusätzlich der Server jede Anfrage von selbst an
# das Telefon des Betriebs — auch die vom Kunden, der das Formular abschickt
# und dann doch nicht auf Senden tippt.
#
# ⚠ Nötig ist die WhatsApp Business *Platform* (Cloud API) im Meta Business
#   Manager. Die WhatsApp Business *App* auf dem Handy genügt nicht. Die
#   sendende Nummer muss eine eigene sein, die NIE in der App registriert war —
#   sie wird zur reinen Servernummer und lässt sich nicht mehr im Handy nutzen.
#
# Aufbau, für den das hier gedacht ist:
#   · die bekannte Kundennummer bleibt in der WhatsApp Business App und
#     empfängt diese Meldungen (OPERATOR_WHATSAPP)
#   · eine zweite Nummer liegt in der Cloud API und verschickt sie
#     (WHATSAPP_PHONE_NUMBER_ID)

# Die Phone Number ID aus dem API-Setup — NICHT die Telefonnummer.
# Eine lange Ziffernfolge, zu finden unter developers.facebook.com
# → deine App → WhatsApp → API Setup.
WHATSAPP_PHONE_NUMBER_ID=

# Der dauerhafte Zugriffsschlüssel eines Systembenutzers.
# Business Settings → Users → System Users → Add (Rolle: Admin)
# → Assign Assets (App + WhatsApp Business Account, volle Kontrolle)
# → Generate New Token, Berechtigungen whatsapp_business_messaging
#   und whatsapp_business_management.
# ⚠ Wird genau einmal angezeigt. Der Schlüssel aus dem API-Setup läuft nach
#   24 Stunden ab und taugt nur zum Ausprobieren.
WHATSAPP_ACCESS_TOKEN=

# Name der bei Meta genehmigten Nachrichtenvorlage (Kategorie „Utility").
# Sie braucht genau einen Platzhalter {{1}} im Textkörper.
WHATSAPP_TEMPLATE_NAME=neue_anfrage
WHATSAPP_TEMPLATE_LOCALE=de

# Wohin die Meldung geht. Nur Ziffern, international, ohne Plus und ohne
# führende Null. Leer = die Nummer aus src/config/site.ts.
OPERATOR_WHATSAPP=

# Version der Graph-API in der Adresse. Meta hält jede Version rund zwei Jahre
# am Leben — hier lässt sie sich ohne Codeänderung hochziehen.
WHATSAPP_GRAPH_VERSION=v26.0
